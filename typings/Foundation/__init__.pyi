"""Narrow public Cocoa declarations used by the native adapter (PyObjC 12.2.2)."""

from typing import Self

class NSObject:
    @classmethod
    def alloc(cls) -> Self: ...
    def init(self) -> Self: ...

class NSDate(NSObject):
    @classmethod
    def dateWithTimeIntervalSince1970_(cls, interval: float) -> Self: ...
    def timeIntervalSince1970(self) -> float: ...

class NSTimeZone(NSObject):
    @classmethod
    def timeZoneWithName_(cls, name: str) -> Self | None: ...
    @classmethod
    def localTimeZone(cls) -> Self: ...
    def name(self) -> str: ...

class NSURL(NSObject):
    @classmethod
    def URLWithString_(cls, value: str) -> Self | None: ...
    def absoluteString(self) -> str: ...

class NSError(NSObject):
    def code(self) -> int: ...

class NSPredicate(NSObject): ...

class NSAppleEventDescriptor(NSObject):
    @classmethod
    def nullDescriptor(cls) -> Self: ...
    @classmethod
    def recordDescriptor(cls) -> Self: ...
    @classmethod
    def descriptorWithTypeCode_(cls, code: int) -> Self: ...
    @classmethod
    def descriptorWithEnumCode_(cls, code: int) -> Self: ...
    @classmethod
    def descriptorWithInt32_(cls, value: int) -> Self: ...
    @classmethod
    def descriptorWithDescriptorType_bytes_length_(
        cls, code: int, data: bytes, length: int
    ) -> Self | None: ...
    @classmethod
    def descriptorWithBundleIdentifier_(cls, bundle: str) -> Self: ...
    @classmethod
    def appleEventWithEventClass_eventID_targetDescriptor_returnID_transactionID_(
        cls, event_class: int, event_id: int, target: Self, return_id: int, transaction_id: int
    ) -> Self: ...
    def setDescriptor_forKeyword_(self, value: Self, keyword: int) -> None: ...
    def coerceToDescriptorType_(self, code: int) -> Self | None: ...
    def setParamDescriptor_forKeyword_(self, value: Self, keyword: int) -> None: ...
    def paramDescriptorForKeyword_(self, keyword: int) -> Self | None: ...
    def sendEventWithOptions_timeout_error_(
        self, options: int, timeout: float, error: None
    ) -> tuple[Self | None, NSError | None]: ...
    def descriptorType(self) -> int: ...
    def typeCodeValue(self) -> int: ...
    def numberOfItems(self) -> int: ...
    def descriptorAtIndex_(self, index: int) -> Self | None: ...
    def stringValue(self) -> str | None: ...
    def int32Value(self) -> int: ...
