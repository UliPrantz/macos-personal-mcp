"""Public EventKit selectors used by the adapters; no participant/private setters."""

from collections.abc import Callable, Sequence
from typing import Self

from Foundation import NSURL, NSDate, NSError, NSObject, NSPredicate, NSTimeZone

EKAuthorizationStatusFullAccess: int
EKAuthorizationStatusWriteOnly: int
EKSpanThisEvent: int

class EKSource(NSObject):
    def sourceIdentifier(self) -> str: ...
    def title(self) -> str: ...
    def sourceType(self) -> int: ...

class EKCalendar(NSObject):
    def calendarIdentifier(self) -> str: ...
    def title(self) -> str: ...
    def source(self) -> EKSource: ...
    def type(self) -> int: ...
    def allowsContentModifications(self) -> bool: ...
    def isSubscribed(self) -> bool: ...
    def isImmutable(self) -> bool: ...

class EKParticipant(NSObject):
    def name(self) -> str | None: ...
    def URL(self) -> NSURL: ...
    def participantStatus(self) -> int: ...
    def participantRole(self) -> int: ...

class EKRecurrenceRule(NSObject): ...

class EKEvent(NSObject):
    @classmethod
    def eventWithEventStore_(cls, store: EKEventStore) -> Self: ...
    def setCalendar_(self, calendar: EKCalendar) -> None: ...
    def setTitle_(self, title: str) -> None: ...
    def setStartDate_(self, value: NSDate) -> None: ...
    def setEndDate_(self, value: NSDate) -> None: ...
    def setTimeZone_(self, zone: NSTimeZone) -> None: ...
    def setAllDay_(self, value: bool) -> None: ...
    def setLocation_(self, value: str) -> None: ...
    def setNotes_(self, value: str) -> None: ...
    def setURL_(self, value: NSURL) -> None: ...
    def eventIdentifier(self) -> str | None: ...
    def calendarItemIdentifier(self) -> str: ...
    def calendarItemExternalIdentifier(self) -> str | None: ...
    def calendar(self) -> EKCalendar: ...
    def title(self) -> str | None: ...
    def startDate(self) -> NSDate: ...
    def endDate(self) -> NSDate: ...
    def isAllDay(self) -> bool: ...
    def timeZone(self) -> NSTimeZone | None: ...
    def location(self) -> str | None: ...
    def notes(self) -> str | None: ...
    def URL(self) -> NSURL | None: ...
    def attendees(self) -> Sequence[EKParticipant] | None: ...
    def recurrenceRules(self) -> Sequence[EKRecurrenceRule] | None: ...
    def isDetached(self) -> bool: ...

class EKEventStore(NSObject):
    def requestFullAccessToEventsWithCompletion_(
        self, completion: Callable[[bool, NSError | None], None]
    ) -> None: ...
    def saveEvent_span_commit_error_(
        self, event: EKEvent, span: int, commit: bool, error: None
    ) -> tuple[bool, NSError | None]: ...
    @classmethod
    def authorizationStatusForEntityType_(cls, entity: int) -> int: ...
    def calendarsForEntityType_(self, entity: int) -> Sequence[EKCalendar]: ...
    def sources(self) -> Sequence[EKSource]: ...
    def predicateForEventsWithStartDate_endDate_calendars_(
        self, start: NSDate, end: NSDate, calendars: Sequence[EKCalendar]
    ) -> NSPredicate: ...
    def eventsMatchingPredicate_(self, predicate: NSPredicate) -> Sequence[EKEvent]: ...
    def eventWithIdentifier_(self, identifier: str) -> EKEvent | None: ...
