"""Narrow public Contacts read selectors; notes are deliberately not requested."""

from collections.abc import Callable, Sequence
from typing import Self

from Foundation import NSError, NSObject

CNAuthorizationStatusAuthorized: int
CNAuthorizationStatusLimited: int

CNContactIdentifierKey: str
CNContactGivenNameKey: str
CNContactMiddleNameKey: str
CNContactFamilyNameKey: str
CNContactOrganizationNameKey: str
CNContactJobTitleKey: str
CNContactEmailAddressesKey: str
CNContactPhoneNumbersKey: str
CNContactPostalAddressesKey: str

class CNLabeledValue[T](NSObject):
    def label(self) -> str | None: ...
    def value(self) -> T: ...

class CNPhoneNumber(NSObject):
    def stringValue(self) -> str: ...

class CNPostalAddress(NSObject):
    def street(self) -> str: ...
    def city(self) -> str: ...
    def state(self) -> str: ...
    def postalCode(self) -> str: ...
    def country(self) -> str: ...
    def ISOCountryCode(self) -> str: ...

class CNContact(NSObject):
    def identifier(self) -> str: ...
    def givenName(self) -> str: ...
    def middleName(self) -> str: ...
    def familyName(self) -> str: ...
    def organizationName(self) -> str: ...
    def jobTitle(self) -> str: ...
    def emailAddresses(self) -> Sequence[CNLabeledValue[str]]: ...
    def phoneNumbers(self) -> Sequence[CNLabeledValue[CNPhoneNumber]]: ...
    def postalAddresses(self) -> Sequence[CNLabeledValue[CNPostalAddress]]: ...

class CNContactFetchRequest(NSObject):
    def initWithKeysToFetch_(self, keys: Sequence[str]) -> Self: ...
    def setUnifyResults_(self, unify: bool) -> None: ...

class CNContactStore(NSObject):
    @classmethod
    def authorizationStatusForEntityType_(cls, entity: int) -> int: ...
    def enumerateContactsWithFetchRequest_error_usingBlock_(
        self,
        request: CNContactFetchRequest,
        error: None,
        callback: Callable[[CNContact, object], None],
    ) -> tuple[bool, NSError | None]: ...
    def unifiedContactWithIdentifier_keysToFetch_error_(
        self, identifier: str, keys: Sequence[str], error: None
    ) -> tuple[CNContact | None, NSError | None]: ...
