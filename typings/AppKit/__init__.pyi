"""Public AppKit selectors used only by the explicit human approval child."""

from typing import Self

from Foundation import NSObject

NSApplicationActivationPolicyAccessory: int
NSAlertSecondButtonReturn: int
type Size = tuple[float, float]
type Rect = tuple[Size, Size]

class NSApplication(NSObject):
    @classmethod
    def sharedApplication(cls) -> Self: ...
    def setActivationPolicy_(self, policy: int) -> bool: ...
    def activateIgnoringOtherApps_(self, activate: bool) -> None: ...

class NSView(NSObject):
    def initWithFrame_(self, frame: Rect) -> Self: ...

class NSButton(NSView):
    def setKeyEquivalent_(self, value: str) -> None: ...

class NSAlert(NSObject):
    def setMessageText_(self, text: str) -> None: ...
    def setInformativeText_(self, text: str) -> None: ...
    def addButtonWithTitle_(self, title: str) -> NSButton: ...
    def setAccessoryView_(self, view: NSView) -> None: ...
    def runModal(self) -> int: ...

class NSScrollView(NSView):
    def setHasVerticalScroller_(self, value: bool) -> None: ...
    def setDocumentView_(self, view: NSView) -> None: ...

class NSTextContainer(NSObject):
    def setContainerSize_(self, size: Size) -> None: ...
    def setWidthTracksTextView_(self, value: bool) -> None: ...

class NSTextView(NSView):
    def setEditable_(self, value: bool) -> None: ...
    def setSelectable_(self, value: bool) -> None: ...
    def setRichText_(self, value: bool) -> None: ...
    def setVerticallyResizable_(self, value: bool) -> None: ...
    def setHorizontallyResizable_(self, value: bool) -> None: ...
    def setMinSize_(self, size: Size) -> None: ...
    def setMaxSize_(self, size: Size) -> None: ...
    def textContainer(self) -> NSTextContainer | None: ...
    def setString_(self, value: str) -> None: ...
